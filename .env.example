# API configuration for the Prompt Maker backend
# The key is read ONLY on the server inside app/api/generate/route.ts.
# It is never exposed to the browser.

# Access key for the OpenAI-compatible endpoint
API_KEY=sk-your-key-here

# OpenAI-compatible base URL (leave default for JembatanAI FreeAI)
API_BASE_URL=https://freeai.jembatanai.com

# The model(s) to use, comma-separated for fallback (first is tried first)
# Available models at this endpoint:
#   openai/gpt-5.6-luna, anthropic/claude-sonnet-5,
#   deepseek/deepseek-v4-pro-0813, deepseek/deepseek-v4.1-flash,
#   z-ai/glm-5.2, z-ai/glm-5.3-flash
API_MODELS=openai/gpt-5.6-luna,anthropic/claude-sonnet-5,z-ai/glm-5.2,deepseek/deepseek-v4.1-flash
